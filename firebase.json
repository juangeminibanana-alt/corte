{
  "hosting": {
    "target": "corte",
    "public": "ui/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-cache, no-store, max-age=0, must-revalidate"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://e-book-21589.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src https://www.tiktok.com https://e-book-21589.firebaseapp.com; upgrade-insecure-requests"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "regex": "^/assets/[^/]+-[A-Za-z0-9_-]{8,}\\.(js|css|woff2?|png|jpe?g|webp|avif|svg|ico)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      { "source": "/descargas/Corte-Windows-1.1.0.zip", "destination": "/descargas/Corte-Windows-1.1.2.zip", "type": 302 },
      { "source": "/descargas/Corte-Android-1.1.0.apk", "destination": "/descargas/Corte-Android-1.1.2.apk", "type": 302 }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "corte-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "/img/**",
        "run": {
          "serviceId": "corte-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "/oauth/**",
        "run": {
          "serviceId": "corte-gateway",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": [
    {
      "target": "corte",
      "rules": "cloud/firebase/storage.rules"
    }
  ]
}
