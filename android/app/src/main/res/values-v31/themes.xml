<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: SplashScreen del sistema con atributos del framework (sin androidx, 04 §B.2). -->
    <style name="Tema.Corte" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:windowSplashScreenBackground">@color/fondo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_frente</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/icono_fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
